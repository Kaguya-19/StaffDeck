_type": "http", "source_tool_name": "order.add", "display_name": "订单添加"}, {"kind": "tool", "id": "tool_e65676bd560f40c5", "name": "product.price_query", "scope": "general", "operation": "tool.invoke/v1", "description": "根据商品名称查询商品价格、品牌、规格和更新时间，用于商品比价。", "input_schema": {"type": "object", "properties": {"product_name": {"type": "string", "description": "商品名称或商品别名，如 A1、A3、iPhone 15"}}, "required": ["product_name"]}, "tool_type": "http", "source_tool_name": "product.price_query", "display_name": "商品价格查询"}, {"kind": "tool", "id": "tool_1d6aa1c5ced942bd", "name": "hr.leave_apply", "scope": "general", "operation": "tool.invoke/v1", "description": "提交请假 / 调休申请", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "员工工号"}, "employee_name": {"type": "string", "description": "员工姓名"}, "leave_type": {"type": "string", "enum": ["annual", "personal", "sick", "compensatory", "marriage", "maternity", "other"], "description": "假期类型：年假/事假/病假/调休/婚假/产假/其他"}, "start_date": {"type": "string", "description": "开始日期 YYYY-MM-DD"}, "end_date": {"type": "string", "description": "结束日期 YYYY-MM-DD"}, "days": {"type": "number", "description": "请假天数（可选，缺省由起止日期估算）"}, "reason": {"type": "string", "description": "请假事由（可选）"}}, "required": ["employee_id", "leave_type", "start_date", "end_date"]}, "tool_type": "http", "source_tool_name": "hr.leave_apply", "display_name": "请假调休申请"}, {"kind": "tool", "id": "tool_28bfd6abf6454953", "name": "admin.supply_request", "scope": "general", "operation": "tool.invoke/v1", "description": "办公用品申领登记", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "申领人工号"}, "employee_name": {"type": "string", "description": "申领人姓名"}, "department": {"type": "string", "description": "所属部门（可选）"}, "items": {"type": "array", "description": "申领物品清单", "items": {"type": "object", "properties": {"name": {"type": "string", "description": "物品名称，如 A4纸/签字笔/墨盒"}, "quantity": {"type": "integer", "description": "数量"}, "unit": {"type": "string", "description": "单位，如 盒/支/包（可选）"}}, "required": ["name", "quantity"]}}, "reason": {"type": "string", "description": "申领事由（可选）"}, "needed_by": {"type": "string", "description": "期望领取日期 YYYY-MM-DD（可选）"}}, "required": ["employee_id", "items"]}, "tool_type": "http", "source_tool_name": "admin.supply_request", "display_name": "办公用品申领"}, {"kind": "tool", "id": "tool_7ff3a99fb1e745ed", "name": "expense.submit", "scope": "general", "operation": "tool.invoke/v1", "description": "提交报销单，返回报销单号与受理状态", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "员工工号"}, "employee_name": {"type": "string", "description": "员工姓名"}, "category": {"type": "string", "description": "报销类别，如 差旅/餐饮/办公"}, "amount": {"type": "number", "description": "报销金额"}, "currency": {"type": "string", "description": "币种，默认 CNY"}, "invoice_no": {"type": "string", "description": "发票号码（可选）"}, "expense_date": {"type": "string", "description": "费用发生日期 YYYY-MM-DD（可选）"}, "description": {"type": "string", "description": "费用说明（可选）"}}, "required": ["employee_id", "category", "amount"]}, "tool_type": "http", "source_tool_name": "expense.submit", "display_name": "报销单提交"}, {"kind": "tool", "id": "tool_9122b5c6804b4d17", "name": "it.grant_permission", "scope": "general", "operation": "tool.invoke/v1", "description": "开通系统权限", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "员工工号"}, "employee_name": {"type": "string", "description": "员工姓名"}, "system": {"type": "string", "description": "目标系统名称，如 CRM/ERP/GitLab/VPN"}, "permission": {"type": "string", "description": "申请的权限/角色，如 只读/管理员/开发者"}, "access_level": {"type": "string", "enum": ["read", "write", "admin"], "description": "访问级别：只读/读写/管理员（可选）"}, "reason": {"type": "string", "description": "申请理由（可选）"}, "duration": {"type": "string", "description": "权限有效期，如 长期/3个月（可选）"}}, "required": ["employee_id", "system", "permission"]}, "tool_type": "http", "source_tool_name": "it.grant_permission", "display_name": "系统权限开通"}, {"kind": "tool", "id": "tool_962e7019ed4f4370", "name": "admin.room_book", "scope": "general", "operation": "tool.invoke/v1", "description": "查询并预订会议室", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "预订人工号"}, "employee_name": {"type": "string", "description": "预订人姓名"}, "date": {"type": "string", "description": "使用日期 YYYY-MM-DD"}, "start_time": {"type": "string", "description": "开始时间 HH:MM"}, "end_time": {"type": "string", "description": "结束时间 HH:MM"}, "attendees": {"type": "integer", "description": "参会人数（可选）"}, "equipment": {"type": "array", "items": {"type": "string"}, "description": "设备需求，如 投影/视频会议/白板（可选）"}, "room_preference": {"type": "string", "description": "偏好会议室或楼层（可选）"}, "topic": {"type": "string", "description": "会议主题（可选）"}}, "required": ["employee_id", "date", "start_time", "end_time"]}, "tool_type": "http", "source_tool_name": "admin.room_book", "display_name": "会议室预订"}, {"kind": "tool", "id": "tool_a85461cd17ab4ca1", "name": "hr.balance_query", "scope": "general", "operation": "tool.invoke/v1", "description": "查询假期余额与考勤记录", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "员工工号"}, "month": {"type": "string", "description": "考勤查询月份 YYYY-MM，默认当月"}, "include_attendance": {"type": "boolean", "description": "是否返回考勤明细，默认 true"}}, "required": ["employee_id"]}, "tool_type": "http", "source_tool_name": "hr.balance_query", "display_name": "假期考勤查询"}, {"kind": "tool", "id": "tool_c27c82b0bdb146ec", "name": "contract.archive_query", "scope": "general", "operation": "tool.invoke/v1", "description": "检索历史合同与判例库", "input_schema": {"type": "object", "properties": {"query": {"type": "string", "description": "检索关键词或自然语言问题"}, "doc_type": {"type": "string", "enum": ["contract", "case", "all"], "description": "检索范围：合同/判例/全部，默认 all"}, "keywords": {"type": "array", "items": {"type": "string"}, "description": "补充关键词（可选）"}, "date_from": {"type": "string", "description": "起始日期 YYYY-MM-DD（可选）"}, "date_to": {"type": "string", "description": "截止日期 YYYY-MM-DD（可选）"}, "top_k": {"type": "integer", "description": "返回条数，默认 5"}}, "required": ["query"]}, "tool_type": "http", "source_tool_name": "contract.archive_query", "display_name": "合同判例检索"}, {"kind": "tool", "id": "tool_d65ea7f31c424a94", "name": "invoice.verify", "scope": "general", "operation": "tool.invoke/v1", "description": "校验发票真伪与要素完整性", "input_schema": {"type": "object", "properties": {"invoice_code": {"type": "string", "description": "发票代码"}, "invoice_number": {"type": "string", "description": "发票号码"}, "invoice_date": {"type": "string", "description": "开票日期 YYYY-MM-DD"}, "amount": {"type": "number", "description": "价税合计金额"}, "check_code": {"type": "string", "description": "校验码（可选）"}, "seller": {"type": "string", "description": "销方名称（可选）"}, "buyer": {"type": "string", "description": "购方名称（可选）"}}, "required": ["invoice_code", "invoice_number"]}, "tool_type": "http", "source_tool_name": "invoice.verify", "display_name": "发票查验"}, {"kind": "tool", "id": "tool_d75c1fe0a1754626", "name": "it.ticket_create", "scope": "general", "operation": "tool.invoke/v1", "description": "登记 IT 工单", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "报障人工号"}, "employee_name": {"type": "string", "description": "报障人姓名"}, "category": {"type": "string", "enum": ["hardware", "software", "network", "account", "other"], "description": "工单类别：硬件/软件/网络/账号/其他"}, "title": {"type": "string", "description": "工单标题"}, "description": {"type": "string", "description": "问题描述"}, "priority": {"type": "string", "enum": ["low", "medium", "high", "urgent"], "description": "优先级（可选，缺省由系统研判）"}, "contact": {"type": "string", "description": "联系方式（可选）"}}, "required": ["employee_id", "title"]}, "tool_type": "http", "source_tool_name": "it.ticket_create", "display_name": "IT工单登记"}, {"kind": "tool", "id": "tool_ecba5f40d1f048c2", "name": "hr.cert_issue", "scope": "general", "operation": "tool.invoke/v1", "description": "开具在职 / 收入证明", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "员工工号"}, "employee_name": {"type": "string", "description": "员工姓名"}, "cert_type": {"type": "string", "enum": ["employment", "income", "employment_income"], "description": "证明类型：在职证明/收入证明/在职及收入证明"}, "purpose": {"type": "string", "description": "用途，如 签证/贷款/租房（可选）"}, "language": {"type": "string", "enum": ["zh", "en"], "description": "证明语言，默认 zh"}, "include_income": {"type": "boolean", "description": "是否包含收入数额（可选）"}}, "required": ["employee_id", "cert_type"]}, "tool_type": "http", "source_tool_name": "hr.cert_issue", "display_name": "在职收入证明开具"}, {"kind": "tool", "id": "tool_ffcb6ab0306f412d", "name": "expense.quota_query", "scope": "general", "operation": "tool.invoke/v1", "description": "查询员工本月报销额度（已用 / 剩余）", "input_schema": {"type": "object", "properties": {"employee_id": {"type": "string", "description": "员工工号"}, "month": {"type": "string", "description": "查询月份 YYYY-MM，默认当月"}}, "required": ["employee_id"]}, "tool_type": "http", "source_tool_name": "expense.quota_query", "display_name": "报销额度查询"}], "snapshot_id": "c2799c93ec4299df4a9a4fb6bdc64cbabbb922ccc63380ada3b4ce83ac67522c"}, "error": null, "receipt": null, "tool_name": "mcp__staffdeck__capability_describe", "arguments": "{\"kind\": \"all\"}", "iteration": 1, "duration_ms": 47, "task_frame_id": "task_e9d488907b44477b", "harness_run_id": "hrun_bf2965283f1647c6", "agent_loop_id": "hloop_544c57f6c9c2445b", "turn_id": "msg_de66545236744933", "user_message_id": "msg_de66545236744933", "client_turn_id": "apijob_837c5673c0fe4be9"}

